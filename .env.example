# Jomma — environment
#
# Copy to `.env` at the repo root. Both apps/web and apps/worker read this one
# file (see packages/shared/src/env.ts). Never commit `.env`.

# ── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────
# Matches docker-compose.yml. Host port is 5433 to avoid clashing with a
# local Postgres on 5432.
DATABASE_URL=postgres://jomma:jomma@localhost:5433/jomma

# Connection pool ceiling per process (web and worker each get their own).
DATABASE_POOL_MAX=10

# ── Web ────────────────────────────────────────────────────────────────
# Public origin the dashboard and API are served from.
APP_URL=http://localhost:3000

# ── Secrets ────────────────────────────────────────────────────────────
# 32+ random bytes, hex or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Signs dashboard sessions and device provisioning payloads.
AUTH_SECRET=change_me_dev_only_0000000000000000000000000000000000000000000000000000

# Fallback HMAC secret for webhook endpoints created without their own secret.
WEBHOOK_SIGNING_SECRET=change_me_dev_only_1111111111111111111111111111111111111111111111111111

# ── Matching ───────────────────────────────────────────────────────────
# Auto-approve threshold and the margin the top candidate must beat the
# runner-up by. Below the margin the payment goes to the manual queue.
# See docs/matching.md — do not raise these without reading it.
MATCH_APPROVE_THRESHOLD=100
MATCH_AMBIGUITY_MARGIN=60

# Default and maximum intent TTL, seconds.
INTENT_DEFAULT_TTL_SECONDS=300
INTENT_MAX_TTL_SECONDS=3600

# ── Device / notifier ──────────────────────────────────────────────────
# Alert when a device heartbeat gap exceeds this, minutes.
HEARTBEAT_GAP_ALERT_MINUTES=15

# Alert when no capture arrives during business hours for this long, hours.
CAPTURE_SILENCE_ALERT_HOURS=3

# Optional comma-separated IP allowlist for /device/v1/*. Empty = allow all.
DEVICE_IP_ALLOWLIST=

# ── Worker ─────────────────────────────────────────────────────────────
# pg-boss schema name. Keeps queue tables out of the app schema.
PGBOSS_SCHEMA=jomma_jobs

# Webhook delivery attempt timeout, milliseconds.
WEBHOOK_TIMEOUT_MS=10000

# ── Localisation ───────────────────────────────────────────────────────
# bn | en. Dashboard default; users can switch per session.
DEFAULT_LOCALE=en

# ── Adapters ───────────────────────────────────────────────────────────
# The Messages bridge is best-effort and off by default (AGENTS.md).
FEATURE_MESSAGES_BRIDGE=false
