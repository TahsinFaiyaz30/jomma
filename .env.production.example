# Jomma — production environment
#
# Set these on the host, not in a file in the repo. `.env` is gitignored and
# `.env.production` would be too, but a hosted deployment should read them from
# the platform's own secret store so they are not sitting on a disk.
#
# Everything here matches packages/shared/src/env.ts. Anything omitted falls back
# to the default in that file.

# ── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────
# A managed Postgres 18. Neon and Supabase both require TLS:
#   postgres://user:pass@host/db?sslmode=require
#
# Neon: use the *pooled* connection string. The direct one has a low connection
# ceiling and a serverless web host opens more than you expect.
DATABASE_URL=

# Managed free tiers cap connections hard. 5 per process is a safe ceiling; with
# a serverless host that scales instances, keep it lower rather than higher.
DATABASE_POOL_MAX=5

# ── Web ────────────────────────────────────────────────────────────────
# The public origin, with scheme and no trailing slash. Three things break if
# this is wrong: the dashboard's origin check rejects sign-in, the scheduler
# cannot reach the sweep endpoint, and QR provisioning hands devices a URL that
# does not resolve.
APP_URL=https://jomma.example.com

# Signing fingerprint of the notifier APK you built and installed, published at
# /.well-known/assetlinks.json so Android will open provisioning QRs directly in
# the app. Must match the key the APK was signed with, and the APK must have
# been built with -PjommaHost pointing at the host above. Get it with:
#
#   keytool -list -v -keystore <your.keystore> -alias <alias>
ANDROID_CERT_SHA256=

# ── Secrets ────────────────────────────────────────────────────────────
# 32+ random bytes each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Signs dashboard sessions and device provisioning, and authenticates
# /api/internal/sweep. The cron job needs the same value.
AUTH_SECRET=

# HMAC for outbound webhooks, and the only credential on the inbound
# /ingest/v1/webhook endpoint. Never share it with a client app.
WEBHOOK_SIGNING_SECRET=

# ── Matching ───────────────────────────────────────────────────────────
# Do not change these without reading docs/matching.md.
MATCH_APPROVE_THRESHOLD=100
MATCH_AMBIGUITY_MARGIN=60

INTENT_DEFAULT_TTL_SECONDS=300
INTENT_MAX_TTL_SECONDS=3600

# ── Device / notifier ──────────────────────────────────────────────────
HEARTBEAT_GAP_ALERT_MINUTES=15
CAPTURE_SILENCE_ALERT_HOURS=3

# Phones are on mobile data with rotating addresses, so an allowlist is usually
# wrong here. Leave empty unless the phones sit behind a fixed egress IP.
DEVICE_IP_ALLOWLIST=

# ── Scheduler ──────────────────────────────────────────────────────────
# Only read by apps/worker. A cron-driven deployment does not need it.
PGBOSS_SCHEMA=jomma_jobs

WEBHOOK_TIMEOUT_MS=10000

# ── Localisation ───────────────────────────────────────────────────────
DEFAULT_LOCALE=en

# ── Adapters ───────────────────────────────────────────────────────────
# Best-effort and off unless you have read apps/bridge/README.md.
FEATURE_MESSAGES_BRIDGE=false
