.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# ── Database ──────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
pgdata/
postgres-data/
dumps/
*.dump
*.sql.gz

# Keep migrations. Ignore local drift snapshots only.
apps/web/drizzle/meta/_journal.json.bak

# ── Captured message fixtures ─────────────────────────────────────────
# Real captures contain live phone numbers and transaction IDs.
# Commit REDACTED fixtures only — see docs/android.md.
apps/web/lib/parsers/fixtures/raw/
*.raw-capture.txt

# ── Messages bridge ───────────────────────────────────────────────────
# Holds a live Messages pairing and the bridge's device token. Treat the
# whole directory as a credential — see apps/bridge/README.md.
.bridge/
apps/bridge/.bridge/

