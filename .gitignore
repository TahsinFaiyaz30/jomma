apps/android/build/
apps/android/*/build/
apps/android/.gradle/
apps/android/local.properties
apps/android/.cxx/
apps/android/captures/
*.apk
*.aab
*.ap_
*.dex
*.class
.externalNativeBuild/
release/

# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

