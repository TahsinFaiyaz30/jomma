<!--
    The themed-icon layer, for launchers where every icon is recoloured to the
    wallpaper palette.

    Separate from the foreground rather than reusing it, because a themed icon
    keeps only the alpha channel and throws the colour away. Pointed at the
    foreground, the amber signal would tint to the same shade as the letter and
    the 80% arc would come out as a smudge — the one part of the mark that is
    supposed to read as distinct instead reads as a mistake. Here the arcs are
    thinned and given their own spacing so they still separate from the letter
    once everything is a single colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled in exactly as the foreground is; see there for why. -->
    <group
        android:pivotX="53.5"
        android:pivotY="53.3"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="0.5"
        android:translateY="0.7">

        <path
            android:pathData="M30,40 H77"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M34,46 Q29,63 43,73 Q55,81 60,70 Q63,63 61,55"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M50,40 Q45,52 47,59 Q50,65 61,58"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M65,41 Q75,45 74,56 L74,72 Q74,78 71,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <path
            android:pathData="M61,33 A9.5,9.5 0 0 1 71.5,34.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M58.5,26.5 A15.5,15.5 0 0 1 74,29.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
