<!--
    জ, drawn as a mark rather than typed as a letter, with a signal rising off it.

    The Bengali letter says whose app this is to the people who will actually
    use it. The two arcs say what it does, and need no language at all: this
    thing watches and tells you. Either alone is ambiguous — a bare "J" could be
    any app, a bare bell is every notification app ever made.

    Why the letter is redrawn instead of set in a font: a pasted glyph is
    text, and text is what an icon stops being the moment it is 48dp wide.
    These are the letter's four strokes — the মাত্রা it hangs from, the bowl,
    the hook that closes the counter, and the stem that drops below the
    baseline — rebuilt monoline at an even weight with round terminals, so the
    mark holds together at launcher size where a typeface's thin joins fill in.
    A Bengali reader still reads জ; everyone else reads a considered shape.

    The arcs are arcs, and not a bell, because of the canvas. An adaptive icon
    guarantees only a 66dp circle out of its 108dp square, so the corners —
    exactly where a badge would want to sit — are the first thing a launcher
    mask cuts. Arcs follow that circle instead of fighting it, which is how
    both elements fit at a legible size rather than two cramped ones.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Everything is drawn at full size and then scaled in by this group.

        The 108dp canvas is misleading: a launcher throws away the outer 18dp
        and then scales what is left to fill the tile, so a mark drawn to the
        66dp "safe" circle arrives touching the rim on all sides. 0.8 pulls it
        back to about two thirds of the visible tile, which is where the
        Google icons it sits beside on a home screen are. The offset re-centres
        the composition, whose middle is a little above and left of the
        canvas's because of the reach of the signal arcs.

        Keeping this as a transform rather than baked into the numbers means
        the path data stays identical to the monochrome and notification
        variants, which are scaled differently and would otherwise drift.
    -->
    <group
        android:pivotX="53.5"
        android:pivotY="53.3"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="0.5"
        android:translateY="0.7">

        <!-- মাত্রা: the headline stroke every Bengali letter hangs from. -->
        <path
            android:pathData="M30,40 H77"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round" />

        <!-- The bowl: down the left, round the base, back up the right wall. -->
        <path
            android:pathData="M34,46 Q29,63 43,73 Q55,81 60,70 Q63,63 61,55"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- The hook down from the মাত্রা into the bowl, closing the counter. -->
        <path
            android:pathData="M50,40 Q45,52 47,59 Q50,65 61,58"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- The stem, which drops below the bowl's baseline as জ's does. -->
        <path
            android:pathData="M65,41 Q75,45 74,56 L74,72 Q74,78 71,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!--
            The signal. Amber against the green so it reads as a separate thing
            happening rather than part of the letter, and the outer arc is held
            back to 80% so the pair has direction — nearer is louder.
        -->
        <path
            android:pathData="M61,34 A9,9 0 0 1 71,35.5"
            android:strokeColor="#FDE047"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M59,28 A15,15 0 0 1 74,31"
            android:strokeColor="#FDE047"
            android:strokeAlpha="0.8"
            android:strokeWidth="4.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
