<!--
    The status bar icon.

    Was a generic exclamation-in-a-circle, which told you something had happened
    but not what had produced it — and a notification you cannot attribute at a
    glance is a notification you swipe away. This is the launcher mark, so the
    row in the shade and the icon on the home screen are recognisably the same
    app.

    The signal arcs are dropped here on purpose. Android renders this at around
    eighteen pixels and keeps only the alpha, so anything at the arcs' weight
    turns into grey fuzz beside the letter. The four strokes of জ are what
    survive at that size, and they are the part that identifies the app.

    Drawn in the same 108-unit space as the launcher icon and scaled by the
    group, so the two cannot drift apart when one is edited.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <group
        android:pivotX="53.5"
        android:pivotY="59"
        android:scaleX="0.4"
        android:scaleY="0.4"
        android:translateX="-41.5"
        android:translateY="-47">

        <path
            android:pathData="M30,40 H77"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M34,46 Q29,63 43,73 Q55,81 60,70 Q63,63 61,55"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M50,40 Q45,52 47,59 Q50,65 61,58"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M65,41 Q75,45 74,56 L74,72 Q74,78 71,78"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
