{
  "name": "jomma",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @jomma/web dev",
    "dev:worker": "pnpm --filter @jomma/worker dev",
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @jomma/web build",
    "start": "pnpm --filter @jomma/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @jomma/web db:generate",
    "db:migrate": "pnpm --filter @jomma/web db:migrate",
    "db:seed": "pnpm --filter @jomma/web db:seed",
    "db:studio": "pnpm --filter @jomma/web db:studio",
    "db:reset": "docker compose down -v && docker compose up -d postgres && sleep 4 && pnpm db:migrate && pnpm db:seed",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ingest": "node scripts/smoke-ingest.mjs",
    "dev:bridge": "pnpm --filter @jomma/bridge start",
    "test:integration": "pnpm --filter @jomma/web test:integration",
    "smoke:checkout": "node scripts/smoke-checkout.mjs",
    "smoke:audit": "node scripts/audit.mjs",
    "smoke:stress": "node scripts/stress.mjs",
    "version:print": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
