{
  "name": "@jomma/sdk",
  "version": "1.4.4",
  "description": "Typed client for the Jomma payment verification API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TahsinFaiyaz30/jomma.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/TahsinFaiyaz30/jomma#readme",
  "bugs": "https://github.com/TahsinFaiyaz30/jomma/issues",
  "keywords": [
    "bkash",
    "nagad",
    "bangladesh",
    "payments",
    "payment-verification",
    "mobile-financial-services"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
